{
  "manifest_version": 3,
  "name": "月标签",
  "description": "一个带有月色氛围的 Microsoft Edge 新标签页扩展。",
  "version": "0.1.0",
  "permissions": [
    "permissions",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://api.bing.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/newtab-redirect.js"
  }
}
