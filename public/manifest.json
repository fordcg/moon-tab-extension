{
  "manifest_version": 3,
  "name": "月标签",
  "version": "0.3.0",
  "description": "Moon Tab 新标签页、小游戏和 Browser AI Assistant 侧边栏。",
  "permissions": ["sidePanel", "storage", "contextMenus", "activeTab", "scripting", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "打开 AI 助手"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "devtools_page": "src/ai-assistant/devtools.html",
  "chrome_url_overrides": {
    "newtab": "src/pages/newtab/index.html"
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开 AI 助手侧边栏"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "src/pages/game/index.html", "src/pages/game/vendor/matter.min.js", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
